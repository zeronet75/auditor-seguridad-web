// Recursos del programa: icono, versión y copyright.
// Compilación: rc /nologo /fo auditor.res auditor.rc
#pragma code_page(65001)
#include <windows.h>

1 ICON "escudo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,1,1,0
 PRODUCTVERSION 4,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Juan Ramon Martin"
            VALUE "FileDescription", "Auditor de Seguridad HTTP (versión nativa)"
            VALUE "FileVersion", "4.1.1.0"
            VALUE "InternalName", "auditor"
            VALUE "LegalCopyright", "© 2026 Juan Ramon Martin. Licencia MIT."
            VALUE "OriginalFilename", "auditor.exe"
            VALUE "ProductName", "Auditor de Seguridad Web"
            VALUE "ProductVersion", "4.1.1.0"
            VALUE "Comments", "zeronet75@gmail.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
